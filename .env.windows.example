# RelatiV Backend — Windows RTX Configuration
# Save as `.env` in the project root on your Lenovo LOQ laptop

APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_URL=http://localhost:9000

# CORS — allows relativclips.com to talk directly to your laptop
CORS_ORIGINS=https://relativclips.com,https://www.relativclips.com,http://localhost:3000

# Directory storage
OUTPUTS_DIR=./outputs
TEMP_DIR=./temp

# Hardware Acceleration: Whisper on NVIDIA CUDA
WHISPER_BACKEND=local
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE=cuda

# Anthropic API Key (Required for virality hook selection & titles)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Video & Encoding
CROP_WIDTH=1080
CROP_HEIGHT=1920
FFMPEG_PRESET=fast
FFMPEG_CQ=23
FFMPEG_AUDIO_BITRATE=192k

# yt-dlp
YTDLP_FORMAT=best[height>=720]/best

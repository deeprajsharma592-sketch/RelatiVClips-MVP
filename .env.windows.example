# RelatiV Backend — Windows RTX Configuration
# Save as `.env` in the project root on your Lenovo LOQ laptop

APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_URL=http://localhost:9000

# Supabase Auth + application database
# Copy the Session pooler URI from Supabase → Connect → Direct Connection string
# → Session pooler. Keep the password in this local .env only; do not commit it.
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@[SESSION-POOLER-HOST]:5432/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=

# CORS — allows relativclips.com to talk directly to your laptop
CORS_ORIGINS=https://relativclips.com,https://www.relativclips.com,https://studio.relativclips.com,https://dash.relativclips.com,https://app.relativclips.com,http://localhost:3000,http://studio.localhost:3000,http://dash.localhost:3000

# Directory storage
OUTPUTS_DIR=./outputs
TEMP_DIR=./temp

# Hardware Acceleration: Whisper on NVIDIA CUDA
WHISPER_BACKEND=local
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE=cuda

# Anthropic API Key (Required for virality hook selection & titles)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Video & Encoding
CROP_WIDTH=1080
CROP_HEIGHT=1920
FFMPEG_PRESET=fast
FFMPEG_CQ=23
FFMPEG_AUDIO_BITRATE=192k

# yt-dlp
YTDLP_FORMAT=best[height>=720]/best

# =============================================================================
# RelatiV Backend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# In production, set these via the platform's secret store (Vercel/Render/Fly).
#
# All variables are loaded by `backend/utils/config.py` (pydantic-settings).
# Anything marked REQUIRED will cause the app to refuse to start without it.
# =============================================================================

# ---- Application ----
APP_ENV=development                     # development | staging | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
PUBLIC_URL=http://localhost:9000        # Public base URL of this backend

# ---- Authentication / founder access ----
# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_TTL_DAYS=7
COOKIE_SECURE=true
ADMIN_EMAILS=deeprajsharma592@gmail.com,deeprajsharma780@gmail.com
FRONTEND_URL=https://relativclips.com

# Supabase Auth. Use the project URL and publishable key (anon key also works).
# Never put a service_role key in frontend env vars.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Set this in the Vercel frontend project to the backend's stable HTTPS origin.
# Do not use a temporary trycloudflare.com URL; it changes when the tunnel restarts.
BACKEND_BASE_URL=

# Verification and password-reset emails use Resend, Postmark, or SMTP.
# Configure ONE provider for real inbox delivery; without one, links are logged
# by the backend for local development only.
RESEND_API_KEY=
# POSTMARK_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Database (REQUIRED in production) ----
# Local docker-compose uses: postgresql+asyncpg://relativ:relativ@postgres:5432/relativ
# For Supabase, use the project's Session pooler DSN, driver `postgresql+asyncpg`,
# and `?sslmode=require`. The backend normalizes that query parameter for asyncpg.
DATABASE_URL=postgresql+asyncpg://relativ:relativ@localhost:5432/relativ

# ---- CORS ----
# Comma-separated list of origins allowed to call the API. The Vercel frontend
# URL is REQUIRED for production. localhost:3000 is for local dev only.
CORS_ORIGINS=http://localhost:3000

# ---- File storage ----
# Where rendered clips + intermediate artifacts land. In prod this MUST be a
# persistent volume (Render disk, Fly volume, or S3). Defaults to ./outputs.
OUTPUT_DIR=/data/outputs
MAX_UPLOAD_MB=2048                      # Cap on user-uploaded video files

# ---- Whisper transcription backend ----
# `local`      → faster-whisper runs in the same container (slower, free, 1.5 GB model)
# `runpod`     → POST audio to RUNPOD_WHISPER_URL, get segments back (faster, $$)
WHISPER_BACKEND=local
WHISPER_MODEL=small.en                  # tiny.en | base.en | small.en | medium.en | large-v3
WHISPER_DEVICE=cpu                      # cpu | cuda (only if you have a GPU)

# ---- RunPod Serverless (only if WHISPER_BACKEND=runpod) ----
RUNPOD_API_KEY=                         # sk-... from runpod.io/console/serverless
RUNPOD_WHISPER_URL=                     # https://api.runpod.ai/v2/<endpoint>/runsync

# ---- Anthropic / Claude (taste stage) ----
# REQUIRED for the new 9-stage pipeline's taste selector. Without this we fall
# back to a heuristic-only selector and clip quality drops ~30%.
ANTHROPIC_API_KEY=                      # sk-ant-... from console.anthropic.com
CLAUDE_MODEL=claude-haiku-4-5           # haiku is cheap + fast; sonnet for hard cases
CLAUDE_MAX_TOKENS=1024

# ---- Xiaomi MiMo (taste / clip calibration) ----
# Strict calibration chain:
# 1. ANTHROPIC_API_KEY -> claude-haiku-4-5-20251001 (direct)
# 2. OPENROUTER_API_KEY -> anthropic/claude-haiku-4.5
# 3. OPENROUTER_API_KEY -> deepseek/deepseek-v4.1-flash-1017
# Model IDs are fixed in code; OpenRouter Auto and "latest" aliases are forbidden.
OPENROUTER_API_KEY=

# ---- YouTube fetcher ----
# Optional: path to a Netscape-format cookies.txt for age-gated / region-locked
# videos. Export from a logged-in YouTube session via "Get cookies.txt LOCALLY"
# browser extension. The repo's `cookies.txt` is .gitignored.
YOUTUBE_COOKIES_FILE=./cookies.txt

# Optional user-machine source proxy. Run User_as_Proxy.py on the computer
# holding the logged-in browser session and expose it through Cloudflare.
RESIDENTIAL_DOWNLOAD_URL=
RESIDENTIAL_DOWNLOAD_TOKEN=

# ---- YouTube cost-saver path ----
# When true, the pipeline skips local audio download + faster-whisper for
# YouTube URLs and uses the YouTube transcript API directly. ~5× cheaper,
# slightly lower quality (no word-level timestamps). Default: true in prod.
YOUTUBE_COST_SAVER=true

# ---- YouTube anti-bot: bgutil PO-token provider ----
# Static client emulation no longer bypasses YouTube's bot checks (as of
# 2025+). The bgutil container runs a local PO-token provider on :4416;
# yt-dlp's bgutil-ytdlp-pot-provider plugin (pip-installed, in
# requirements.txt) calls it per video. Set the URL to your bgutil host:
#   - docker-compose local: http://bgutil:4416
#   - bare-metal on same host: http://127.0.0.1:4416
#   - Hetzner VPS: http://127.0.0.1:4416 (if bgutil runs as systemd sidecar)
# The bgutil Docker image is `brainicism/bgutil-ytdlp-pot-provider:latest`.
# See https://github.com/Brainicism/bgutil-ytdlp-pot-provider for details.
BGUTIL_POT_BASE_URL=http://127.0.0.1:4416

# ---- Optional SOCKS5 residential proxy (cloud-IP workarounds) ----
# Leave empty unless your server's IP is flagged by YouTube. If it is,
# point this at a SOCKS5 tunnel on a residential IP (your home network,
# a friend's home, or a small VPS at a residential ISP). Format:
#   socks5://user:pass@host:1080
#   socks5://host:1080  (no auth)
# At ~$0/GB on a private tunnel, this is vastly cheaper than commercial
# residential proxy pools. Skip on first deploy; add only if YouTube
# returns 403/Sign-in-to-confirm despite bgutil.
YT_PROXY=

# ---- Next.js frontend (Vercel) ----
# Comma-separated list of origins allowed to call the API. Vercel URL is
# REQUIRED in production. localhost:3000 is for dev only.
CORS_ORIGINS=http://localhost:3000
# The public base URL the Vercel frontend uses to reach the backend.
# On Hetzner: https://api.relativ.video (behind Caddy reverse proxy)
# On Vercel env: NEXT_PUBLIC_API_BASE=https://api.relativ.video
NEXT_PUBLIC_API_BASE=http://localhost:9000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay Standard Checkout (backend only; key ID returned by create-order)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ytagent verified high-quality source downloader
YTAGENT_ENABLED=1
YTAGENT_MIN_HEIGHT=720
YTAGENT_MAX_HEIGHT=1080
YTAGENT_TIMEOUT_SECONDS=240
# Optional; defaults to cache/bgutil-ytdlp-pot-provider inside the repo.
YTAGENT_BGUTIL_HOME=
# Optional override. RelatiV defaults to best video <=1080p + best audio.
YTAGENT_FORMAT=
